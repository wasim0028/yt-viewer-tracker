# Copy this file to .env and fill in your own values.

# Your YouTube Data API v3 key (see README.md for how to get one)
YOUTUBE_API_KEY=

# PostgreSQL connection. Provide a full connection string here - this is#AIzaSyAjE1GGUbLps1VP08dyJVb7rxeALkSFrNI#
# what every managed provider (Heroku, Render, Supabase, RDS, Neon, a
# self-hosted server, etc.) gives you. If you omit DATABASE_URL, the app
# falls back to the standard PGHOST / PGUSER / PGPASSWORD / PGDATABASE /
# PGPORT environment variables instead - use whichever your host expects.
DATABASE_URL=postgres://user:password@localhost:5432/yt_viewer_tracker

# Set to "true" if your Postgres provider requires SSL (common on managed
# hosts like Heroku, Render, Supabase). Leave "false" for a local/self-hosted
# server without SSL configured.
PGSSL=false

# Port the backend server listens on
PORT=4000

# How often to poll YouTube for viewer counts, in milliseconds.
# 180000 = 3 minutes. This costs ~1 unit/tick total (all channels combined,
# batched into one call) regardless of how many channels or streams you have,
# as long as the combined total is <= 50 currently-live videos.
POLL_INTERVAL_MS=180000

# How often to re-run the "which videos are live right now" discovery per
# channel (only used for channels with autoDiscover: true in config.json).
# This is the expensive call - 100 units per channel, per refresh - so keep
# it much less frequent than POLL_INTERVAL_MS.
# 3600000 = 1 hour.
#
# Rough daily quota cost = channels_with_autoDiscover * 100 * (24 / refresh_hours)
#   e.g. 6 channels, refreshed hourly  -> 6 * 100 * 24 = 14,400 units/day (too much)
#   e.g. 6 channels, refreshed every 3h -> 6 * 100 * 8  = 4,800 units/day (fine)
# Pin known-stable streams as "videoIds" in config.json instead of relying on
# autoDiscover where you can - pinned IDs cost nothing extra to check.
LIVE_LOOKUP_REFRESH_MS=3600000

# On top of the timer above, the poller ALSO watches for a channel's live
# stream count dropping (a sign a stream ended, and maybe a new one started)
# and reacts by rediscovering on the very next tick instead of waiting for
# the timer - this is what actually keeps the tracked set fresh on channels
# that rotate through short segments often. This cooldown is a safety net so
# a channel that's constantly flapping can't force full-price discovery
# calls every single tick - it won't rediscover reactively more often than
# this, even if drops keep happening. 1800000 = 30 minutes.
#
# Worst-case daily cost if a channel drops constantly and hits this cooldown
# every time = channels_with_autoDiscover * 100 * (24 / cooldown_hours) -
# same formula and same table as above, since this is just the floor on how
# often reactive triggering can fire.
REACTIVE_REDISCOVER_COOLDOWN_MS=1800000

# Optional: point this at a real ad network/ad server's API to serve real
# ads in the side rail slots. Its response must match (or be transformed to
# match, in backend/ads.js) { "ads": [{ id, type: "image"|"video", mediaUrl,
# linkUrl, altText }] }. ADS_API_KEY is sent as a Bearer token if your ad
# API needs auth. Leave both blank to use the sample ad in backend/ads.json
# instead - the app works fine either way.
ADS_API_URL=
ADS_API_KEY=
