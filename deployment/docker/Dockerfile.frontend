FROM node:22-alpine AS builder

WORKDIR /src

COPY frontend/package.json frontend/package-lock.json* ./

RUN --mount=type=cache,id=yt-viewer-tracker-npm,target=/root/.npm npm ci --silent --cache /root/.npm

COPY frontend/. .

RUN npm run build
# Vite's default build output directory is dist/, not build/ - this
# project has no custom build.outDir set, confirmed directly from this
# project's own build logs during development.

FROM nginx:1.27-alpine

RUN rm /etc/nginx/conf.d/default.conf

COPY deployment/docker/nginx.conf /etc/nginx/conf.d/app.conf

COPY --from=builder /src/dist /usr/share/nginx/html

RUN mkdir -p /var/cache/nginx/client_temp \
             /var/cache/nginx/proxy_temp \
             /var/cache/nginx/fastcgi_temp \
             /var/cache/nginx/uwsgi_temp \
             /var/cache/nginx/scgi_temp \
             /var/run \
             /var/log/nginx \
    && touch /var/run/nginx.pid \
    && chown -R 101:101 /var/cache/nginx /var/run /var/run/nginx.pid /var/log/nginx /usr/share/nginx/html

USER 101

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD ["wget", "--quiet", "--tries=1", "--spider", "http://localhost:8080/health"]

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
