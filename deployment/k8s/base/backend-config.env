# Backend runtime settings (not secret). Kustomize turns this file into the
# ConfigMap "backend-config" with a content hash in its name, e.g.
# backend-config-7f2k9d. Edit a value, commit, push: the name changes, the
# Deployment's reference changes with it, and the pods roll by themselves.
# Real secrets (DATABASE_URL, API keys) are NOT here: they come from Secrets
# Manager through External Secrets.
NODE_ENV=production
PORT=4000
PGSSL=true
POLL_INTERVAL_MS=180000
LIVE_LOOKUP_REFRESH_MS=3600000
REACTIVE_REDISCOVER_COOLDOWN_MS=1200000
# Just an endpoint URL, so not secret; its key lives in the api-keys secret.
# Leave empty to use the app's built-in local ads.json.
ADS_API_URL=
